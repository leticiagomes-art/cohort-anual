<style>
:root{
  --canvas:#FBFCFD; --surface:#FFFFFF; --rail:#14243F; --rail-2:#1F3864;
  --line:#E4E9F0; --line-soft:#EFF3F8;
  --ink:#0F1E38; --ink-2:#3D4C63; --muted:#7C8AA0;
  --navy:#1F3864; --blue:#2F5597; --gold:#C9A227;
  --red:#C0392B; --amber:#E8A33D; --green:#2E7D32; --teal:#1F7A8C;
  --c0:#F2F6FC; --c1:#DCE7F5; --c2:#F7DCC9; --c3:#EFB295; --c4:#DC7C60; --c5:#B8442F;
  --r:10px; --pad:20px;
  --fd:'Archivo',system-ui,sans-serif;
  --fb:'IBM Plex Sans',system-ui,sans-serif;
  --fm:'IBM Plex Mono',ui-monospace,monospace;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--canvas);color:var(--ink);font-family:var(--fb);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}
.num{font-family:var(--fm);font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1}

/* ---------- shell ---------- */
.shell{display:grid;grid-template-columns:216px 1fr;min-height:100vh}
.rail{background:var(--rail);color:#fff;padding:22px 0;position:sticky;top:0;height:100vh;overflow-y:auto}
.brand{padding:0 20px 22px;border-bottom:1px solid rgba(255,255,255,.09);margin-bottom:16px}
.brand b{font-family:var(--fd);font-size:16px;font-weight:700;letter-spacing:-.2px;display:block}
.brand span{font-size:10.5px;color:#8FA4C8;letter-spacing:.9px;text-transform:uppercase;display:block;margin-top:4px}
.navgrp{padding:0 12px;margin-bottom:6px}
.navgrp em{font-style:normal;font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;color:#6E82A8;padding:12px 8px 6px;display:block}
.nav{display:flex;align-items:center;gap:9px;width:100%;padding:9px 10px;border:0;background:none;color:#C6D3E8;
  font-family:var(--fb);font-size:13.5px;text-align:left;border-radius:7px;cursor:pointer;transition:background .13s,color .13s}
.nav:hover{background:rgba(255,255,255,.06);color:#fff}
.nav[aria-selected="true"]{background:var(--rail-2);color:#fff;font-weight:600}
.nav .dot{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.5;flex:none}
.nav[aria-selected="true"] .dot{background:var(--gold);opacity:1}
.railfoot{padding:16px 20px;margin-top:14px;border-top:1px solid rgba(255,255,255,.09);font-size:10.5px;color:#7089B0;line-height:1.6}

.main{padding:26px 30px 60px;max-width:1560px}
.head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:22px;flex-wrap:wrap}
h1{font-family:var(--fd);font-size:25px;font-weight:700;letter-spacing:-.5px;margin:0 0 5px}
.sub{color:var(--muted);font-size:13px;margin:0;max-width:760px}
.periodo{font-family:var(--fm);font-size:11px;color:var(--muted);border:1px solid var(--line);
  background:var(--surface);padding:7px 12px;border-radius:99px;white-space:nowrap}

/* ---------- cards ---------- */
.grid{display:grid;gap:14px}
.g4{grid-template-columns:repeat(4,1fr)}
.g3{grid-template-columns:repeat(3,1fr)}
.g2{grid-template-columns:repeat(2,1fr)}
.g23{grid-template-columns:2fr 1fr}
.g32{grid-template-columns:1.6fr 1fr}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:var(--pad)}
.card h3{font-family:var(--fd);font-size:14.5px;font-weight:600;margin:0 0 3px;letter-spacing:-.1px}
.card .cap{font-size:11.5px;color:var(--muted);margin:0 0 14px;line-height:1.45}
.kpi{position:relative;padding-left:22px}
.kpi::before{content:"";position:absolute;left:0;top:16px;bottom:16px;width:3px;border-radius:3px;background:var(--line)}
.kpi.is-red::before{background:var(--red)} .kpi.is-amber::before{background:var(--amber)}
.kpi.is-green::before{background:var(--green)} .kpi.is-navy::before{background:var(--navy)}
.kpi .lab{font-size:10.5px;letter-spacing:1.1px;text-transform:uppercase;color:var(--muted)}
.kpi .val{font-family:var(--fm);font-size:29px;font-weight:600;letter-spacing:-1px;margin:5px 0 2px;line-height:1.1}
.kpi .note{font-size:11.5px;color:var(--muted)}
.kpi .spark{margin-top:10px}

/* ---------- tags ---------- */
.tag{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;letter-spacing:.4px;
  padding:3px 8px;border-radius:5px;text-transform:uppercase;white-space:nowrap}
.t-red{background:#FCEBE9;color:#9E2E22} .t-amber{background:#FDF3E3;color:#8A5A00}
.t-green{background:#E9F3EA;color:#1F5C23} .t-blue{background:#EAF0FA;color:#254B87}
.t-grey{background:#F0F3F7;color:#5C6B82}

/* ---------- tabelas ---------- */
.tw{overflow:auto;max-height:560px;border-radius:8px;border:1px solid var(--line-soft)}
table{width:100%;border-collapse:collapse;font-size:12.5px}
th{position:sticky;top:0;background:var(--blue);color:#fff;font-weight:600;font-size:10.5px;letter-spacing:.5px;
  text-transform:uppercase;padding:9px 10px;text-align:left;white-space:nowrap;z-index:2;cursor:pointer;user-select:none}
th.r,td.r{text-align:right}
th:hover{background:#26467E}
th .ar{opacity:.45;font-size:9px;margin-left:3px}
td{padding:8px 10px;border-bottom:1px solid var(--line-soft);white-space:nowrap}
tbody tr:nth-child(even){background:#FAFBFD}
tbody tr:hover{background:#F2F6FC}
td.num{font-family:var(--fm);font-variant-numeric:tabular-nums}
.bar-cell{position:relative}
.bar-cell i{position:absolute;left:0;top:50%;transform:translateY(-50%);height:16px;background:#E7EEF9;border-radius:3px;z-index:0}
.bar-cell span{position:relative;z-index:1}

/* ---------- cohort ---------- */
.cohort{overflow:auto;border:1px solid var(--line-soft);border-radius:8px}
.cohort table{font-size:11.5px;border-collapse:separate;border-spacing:0}
.cohort th{background:#F7F9FC;color:var(--ink-2);border-bottom:1px solid var(--line);cursor:default}
.cohort th:hover{background:#F7F9FC}
.cohort td{border:0;padding:0}
.cohort .cel{height:26px;min-width:44px;display:flex;align-items:center;justify-content:center;
  font-family:var(--fm);font-size:11px;color:var(--ink);border-right:1px solid #fff;border-bottom:1px solid #fff}
.cohort .lbl{font-family:var(--fm);font-size:11px;color:var(--ink-2);padding:0 10px;white-space:nowrap;
  background:#FCFDFE;border-right:1px solid var(--line);height:26px;display:flex;align-items:center}
.cohort .fut{background:repeating-linear-gradient(135deg,#F7F9FC,#F7F9FC 4px,#EDF1F7 4px,#EDF1F7 8px);color:transparent}
.legend{display:flex;align-items:center;gap:10px;margin-top:12px;font-size:11px;color:var(--muted);flex-wrap:wrap}
.legend .sw{width:26px;height:12px;border-radius:2px;display:inline-block}

/* ---------- misc ---------- */
.split{display:flex;gap:2px;height:26px;border-radius:5px;overflow:hidden;margin:8px 0 4px}
.split div{display:flex;align-items:center;justify-content:center;color:#fff;font-size:10.5px;font-weight:600;font-family:var(--fm)}
.note{background:#FFF9EC;border-left:3px solid var(--gold);padding:13px 15px;border-radius:0 8px 8px 0;font-size:12.5px;color:#5C4A17;line-height:1.55}
.note b{color:#3F3210}
.alerta{background:#FDF0EE;border-left:3px solid var(--red);padding:13px 15px;border-radius:0 8px 8px 0;font-size:12.5px;color:#7A2A1F;line-height:1.55}
.ok{background:#EDF5EE;border-left:3px solid var(--green);padding:13px 15px;border-radius:0 8px 8px 0;font-size:12.5px;color:#1D4A21;line-height:1.55}
.view{display:none} .view.on{display:block}
.sec{font-family:var(--fd);font-size:11px;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted);
  margin:26px 0 12px;padding-bottom:7px;border-bottom:1px solid var(--line)}
.ctl{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.btn{border:1px solid var(--line);background:var(--surface);color:var(--ink-2);font-family:var(--fb);font-size:12px;
  padding:6px 12px;border-radius:7px;cursor:pointer;transition:.13s}
.btn:hover{border-color:var(--blue);color:var(--blue)}
.btn[aria-pressed="true"]{background:var(--navy);border-color:var(--navy);color:#fff}
input[type=search]{border:1px solid var(--line);border-radius:7px;padding:7px 11px;font-family:var(--fb);font-size:12.5px;
  width:230px;background:var(--surface);color:var(--ink)}
input[type=search]:focus{outline:2px solid #BFD3F0;outline-offset:1px;border-color:var(--blue)}
.dl{display:grid;grid-template-columns:190px 1fr;gap:9px 18px;font-size:12.5px}
.dl dt{color:var(--blue);font-weight:600;font-size:11px;letter-spacing:.5px;text-transform:uppercase;padding-top:2px}
.dl dd{margin:0;color:var(--ink-2);line-height:1.55}
svg text{font-family:var(--fm);font-variant-numeric:tabular-nums}
.tip{position:fixed;pointer-events:none;background:var(--rail);color:#fff;font-size:11.5px;padding:7px 10px;
  border-radius:6px;opacity:0;transition:opacity .1s;z-index:99;font-family:var(--fm);white-space:pre;line-height:1.55}
:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
@media (max-width:1180px){.shell{grid-template-columns:1fr}.rail{position:static;height:auto;display:flex;
  flex-wrap:wrap;gap:4px;padding:14px}.brand{width:100%;border:0;margin:0 0 8px;padding:0 8px 10px}
  .navgrp{padding:0}.navgrp em{display:none}.g4,.g3,.g2,.g23,.g32{grid-template-columns:1fr}.main{padding:18px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
@media print{.rail{display:none}.shell{grid-template-columns:1fr}.view{display:block!important;page-break-after:always}}
</style>
</head>
