function bindTips(){$$('.pt').forEach(p=>{
  if(p.dataset.b)return; p.dataset.b=1;
  p.addEventListener('mousemove',e=>tipOn(e,p.dataset.t));p.addEventListener('mouseleave',tipOff)})}
function go(v){
  $$('.nav').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.v===v)));
  const [t,s]=META[v];
  $('#main').innerHTML=`<div class="head"><div><h1>${t}</h1><p class="sub">${s}</p></div>
    <div class="periodo">01 jan → 26 ago 2026 · 31 contas</div></div><div class="view on">${V[v]()}</div>`;
  if(v==='cohort'){setCoh($('#main .ctl .btn'),false);setCoh($('#main .cbp[aria-pressed="true"]')||$('#main .cbp'),true);}
  bindTips();
  window.scrollTo(0,0);
}
window.setBase=(btn,base)=>{
  $$('#main .ctl .btn').forEach(b=>b.setAttribute('aria-pressed','false'));btn.setAttribute('aria-pressed','true');
  const src=base==='caixa'?D.mensal:D.coorte;
  $('#evT').textContent=base==='caixa'?'Mensal · base caixa':'Mensal · base safra';
  $('#evC').textContent=base==='caixa'?'Taxa de reembolso sobre o gross do mês, pela data em que o dinheiro saiu.'
    :'Reembolso atribuído ao mês em que a venda foi feita. Junho em diante ainda não maturou.';
  $('#evChart').innerHTML=lineChart([{name:'% reembolso',values:src.map(r=>N(r['% Reembolso ($)'])*100),
    color:base==='caixa'?'var(--red)':'var(--blue)',area:1}],
    {labels:src.map(r=>mesLbl(r.mes)),min:0,max:32,fmtY:v=>v.toFixed(0)+'%',fmtT:v=>v.toFixed(1)+'%'});
  $$('#evChart .pt').forEach(p=>{p.addEventListener('mousemove',e=>tipOn(e,p.dataset.t));p.addEventListener('mouseleave',tipOff)});
};
$$('.nav').forEach(b=>b.onclick=()=>go(b.dataset.v));
go('geral');
</script>
