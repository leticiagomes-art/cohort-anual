        `<div style="border:1px solid var(--line);border-radius:8px;padding:10px 14px;background:#FCFDFE">
          <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px">${l}</div>
          <div class="num" style="font-size:20px;font-weight:600;margin:2px 0 1px">${pct(g[k])}</div>
          ${cmp(g[k],ref_[k])}</div>`).join('')}</div>`;
    } else { kpi.innerHTML=''; }
  }
  setTimeout(bindTips,0);
};

