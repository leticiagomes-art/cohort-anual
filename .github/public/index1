    {h:'Virada',get:r=>r['Data da virada']},
    {h:'Taxa Black',r:1,num:1,get:r=>pct(N(r['Taxa BLACK (mix 70/30)'])),sort:r=>N(r['Taxa BLACK (mix 70/30)'])??-1},
    {h:'Taxa White',r:1,num:1,get:r=>pct(N(r['Taxa WHITE'])),sort:r=>N(r['Taxa WHITE'])??-1},
