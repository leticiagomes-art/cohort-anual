  A taxa White sai baixa por construção, não necessariamente por mérito. MaroBrain é a exceção que interessa: piorou mesmo com janela curta.</div>`;
};

const NAO_AFIL='Sem Afiliado / Pedido Direto';
V.afiliados=()=>{
  const direto=D.afiliados.find(r=>r.Afiliado===NAO_AFIL);
  const a=D.afiliados.filter(r=>(N(r['Gross total'])>0||r.aov_white)&&r.Afiliado!==NAO_AFIL);
  const st={}; a.forEach(r=>{const k=String(r.Status||'—').split(' (')[0];st[k]=(st[k]||0)+1});
  const crit=a.filter(r=>/CRITICO/.test(String(r['Alerta de qualidade']||'')));
  const cards=[
    {l:'Pararam',v:st['PAROU']||0,n:'mais de 30 dias sem vender',c:'is-red'},
    {l:'Esfriando',v:st['ESFRIANDO']||0,n:'de 7 a 30 dias parados',c:'is-amber'},
    {l:'Ativos',v:(st['CRESCENDO']||0)+(st['ESTAVEL']||0)+(st['CAINDO']||0),n:`${st['CRESCENDO']||0} crescendo · ${st['CAINDO']||0} caindo`,c:'is-green'},
    {l:'Saída ≥30%',v:crit.length,n:moneyK(crit.reduce((s,r)=>s+N(r['Gross total']),0))+' de gross',c:'is-red'}
  ].map(k=>`<div class="card kpi ${k.c}"><div class="lab">${k.l}</div>
    <div class="val">${k.v}</div><div class="note">${k.n}</div></div>`).join('');
  const meses=['2026-01','2026-02','2026-03','2026-04','2026-05','2026-06','2026-07','2026-08'];
  return `<div class="grid g4">${cards}</div>
  ${direto?`<div class="note" style="margin-top:14px"><b>Fora deste recorte:</b> venda sem afiliado (tráfego direto e recompra)
    somou ${moneyK(N(direto['Gross total']))} no ano com ${pct(N(direto['Taxa de saida']))} de saída.
    Não é afiliado e por isso não entra no ranking, mas continua nos totais da operação.</div>`:''}
  <div class="note" style="margin:10px 0 4px"><b>Contas internas</b> (HelpGrid, MaxWeb, Tiger Offers, gestores) ficam fora deste ranking, mas continuam dentro dos totais da operação.</div>
  <div class="sec">Progressão mês a mês</div>
  <div class="ctl"><input type="search" id="qaf" placeholder="Buscar afiliado…" oninput="filtAf(this.value)">
    <button class="btn" onclick="filtAf('',this)" aria-pressed="true">Todos</button>
    <button class="btn" onclick="filtAf('__crit',this)">Só críticos</button>
    <button class="btn" onclick="filtAf('__cresc',this)">Só crescendo</button></div>
  <div id="afWrap">${afTable(a.sort((x,y)=>N(y['Gross total'])-N(x['Gross total'])),meses)}</div>
  <p style="font-size:11.5px;color:var(--muted);margin-top:10px">Todos os afiliados. Use a busca para filtrar.</p>`;
};
function afTable(rows,meses){
  return table([
    {h:'Afiliado',get:r=>String(r.Afiliado).slice(0,30)},
    ...meses.map(m=>({h:mesLbl(m),r:1,num:1,get:r=>{const v=N(r[m]);
      return v?`<span style="color:${v>50000?'var(--navy)':'var(--ink-2)'}">${Math.round(v/1000)}k</span>`:'<span style="color:#CBD5E1">·</span>'},
      sort:r=>N(r[m])||0})),
    {h:'Gross ano',r:1,num:1,get:r=>money(N(r['Gross total'])),sort:r=>N(r['Gross total'])||0,bar:r=>N(r['Gross total'])/1e6},
    {h:'% saída',r:1,num:1,get:r=>{const v=N(r['Taxa de saida']);
      return v==null?'—':`<b style="color:${v>=.3?'var(--red)':v>=.2?'var(--amber)':'var(--ink)'}">${pct(v)}</b>`},sort:r=>N(r['Taxa de saida'])??-1},
    {h:'AOV Líq. White',r:1,num:1,get:r=>{
      const w=r.aov_white; const b=r.aov_black;
      if(!w) return '<span style="color:#CBD5E1">—</span>';
      const tip=b?`AOV Líq. Black (jun–jul): $${b.toFixed(2)}`:'sem dado Black';
      const delta=b?(w-b):null;
      const dspan=delta!=null?`<span style="font-size:10px;color:${delta>0?'var(--green)':'var(--red)'}"> ${delta>0?'▲':'▼'}$${Math.abs(delta).toFixed(0)}</span>`:'';
      return `<span class="pt" data-t="${tip}" style="cursor:default;font-family:var(--fm)">$${w.toFixed(0)}${dspan}</span>`;
    },sort:r=>r.aov_white??-1},
    {h:'Var. 3m',r:1,num:1,get:r=>{const v=N(r['Variacao 3m']);
      return v==null?'—':`<span style="color:${v>0?'var(--green)':'var(--red)'}">${v>0?'+':''}${(v*100).toFixed(0)}%</span>`},sort:r=>N(r['Variacao 3m'])??-99},
    {h:'Parado há',r:1,num:1,get:r=>N(r['Dias sem vender'])+'d',sort:r=>N(r['Dias sem vender'])||0},
    {h:'Status',get:r=>{const s=String(r.Status||'').split(' (')[0];
      const cls=s==='PAROU'?'t-red':s==='ESFRIANDO'?'t-amber':s==='CRESCENDO'?'t-green':s==='CAINDO'?'t-amber':'t-blue';
      return `<span class="tag ${cls}">${s.toLowerCase()}</span>`},sort:r=>String(r.Status)}
  ],rows);
}
function filtAf(q,btn){
  if(btn){$$('#main .ctl .btn').forEach(b=>b.setAttribute('aria-pressed','false'));btn.setAttribute('aria-pressed','true')}
  const meses=['2026-01','2026-02','2026-03','2026-04','2026-05','2026-06','2026-07','2026-08'];
  let rows=D.afiliados.filter(r=>(N(r['Gross total'])>0||r.aov_white)&&r.Afiliado!==NAO_AFIL);
  if(q==='__crit')rows=rows.filter(r=>/CRITICO/.test(String(r['Alerta de qualidade']||'')));
  else if(q==='__cresc')rows=rows.filter(r=>/CRESCENDO/.test(String(r.Status||'')));
  else if(q)rows=rows.filter(r=>String(r.Afiliado).toLowerCase().includes(q.toLowerCase()));
  rows=rows.sort((x,y)=>N(y['Gross total'])-N(x['Gross total']));
  $('#afWrap').innerHTML=afTable(rows,meses);
}

