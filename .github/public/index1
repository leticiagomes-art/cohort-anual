const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const N=v=>v==null||v===''||Number.isNaN(+v)?null:+v;
const money=v=>v==null?'—':'$'+Math.round(v).toLocaleString('pt-BR');
const moneyK=v=>{if(v==null)return'—';const a=Math.abs(v);
  if(a>=1e6)return'$'+(v/1e6).toFixed(2).replace('.',',')+' mi';
  if(a>=1e3)return'$'+Math.round(v/1e3)+' mil';return'$'+Math.round(v)};
const pct=(v,d=1)=>v==null?'—':(v*100).toFixed(d).replace('.',',')+'%';
const mesLbl=m=>({'2026-01':'Jan','2026-02':'Fev','2026-03':'Mar','2026-04':'Abr','2026-05':'Mai',
  '2026-06':'Jun','2026-07':'Jul','2026-08':'Ago'})[m]||m;
const el=(t,c,h)=>{const e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e};
const tip=$('#tip');
function tipOn(e,txt){tip.textContent=txt;tip.style.opacity=1;
  tip.style.left=Math.min(e.clientX+14,innerWidth-tip.offsetWidth-10)+'px';
  tip.style.top=(e.clientY-tip.offsetHeight-10)+'px'}
function tipOff(){tip.style.opacity=0}

/* ---------------- SVG charts ---------------- */
function svgEl(w,h){return `<svg viewBox="0 0 ${w} ${h}" width="100%" style="display:block;overflow:visible" role="img">`}

function lineChart(series,opts={}){
  const w=opts.w||620,h=opts.h||260,m={t:14,r:16,b:34,l:opts.l||44};
  const iw=w-m.l-m.r, ih=h-m.t-m.b;
  const labels=opts.labels||[];
  const all=series.flatMap(s=>s.values.filter(v=>v!=null));
  let lo=opts.min!=null?opts.min:Math.min(...all), hi=opts.max!=null?opts.max:Math.max(...all);
  if(lo===hi){hi=lo+1}
  const pad=(hi-lo)*.12; if(opts.min==null)lo-=pad; if(opts.max==null)hi+=pad;
  const X=i=>m.l+(labels.length<2?iw/2:i*iw/(labels.length-1));
  const Y=v=>m.t+ih-(v-lo)/(hi-lo)*ih;
  let s=svgEl(w,h);
  for(let i=0;i<=4;i++){const v=lo+(hi-lo)*i/4,y=Y(v);
    s+=`<line x1="${m.l}" y1="${y}" x2="${w-m.r}" y2="${y}" stroke="var(--line-soft)"/>`;
    s+=`<text x="${m.l-8}" y="${y+3.5}" text-anchor="end" font-size="10" fill="var(--muted)">${opts.fmtY?opts.fmtY(v):Math.round(v)}</text>`}
  labels.forEach((l,i)=>{if(labels.length<=14||i%2===0)
    s+=`<text x="${X(i)}" y="${h-12}" text-anchor="middle" font-size="10.5" fill="var(--ink-2)">${l}</text>`});
  series.forEach(se=>{
    const pts=se.values.map((v,i)=>v==null?null:[X(i),Y(v)]).filter(Boolean);
    if(!pts.length)return;
    const d=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' ');
    if(se.area)s+=`<path d="${d} L${pts.at(-1)[0]} ${m.t+ih} L${pts[0][0]} ${m.t+ih} Z" fill="${se.color}" opacity=".07"/>`;
    s+=`<path d="${d}" fill="none" stroke="${se.color}" stroke-width="${se.dash?1.8:2.4}" stroke-linecap="round"
        stroke-linejoin="round" ${se.dash?'stroke-dasharray="5 5"':''}/>`;
    if(!se.dash)pts.forEach((p,i)=>{s+=`<circle cx="${p[0]}" cy="${p[1]}" r="3.4" fill="#fff" stroke="${se.color}" stroke-width="2"
      class="pt" data-t="${(se.name||'')+' · '+(labels[i]||'')+'\n'+(opts.fmtT?opts.fmtT(se.values[i]):se.values[i])}"/>`});
  });
  s+='</svg>';
  const leg=series.filter(x=>x.name).map(x=>
    `<span style="display:inline-flex;align-items:center;gap:6px;margin-right:16px;font-size:11.5px;color:var(--ink-2)">
     <i style="width:14px;height:2.6px;background:${x.color};border-radius:2px;display:inline-block"></i>${x.name}</span>`).join('');
  return s+(leg?`<div style="margin-top:10px">${leg}</div>`:'');
}

function barsH(rows,opts={}){
  const max=Math.max(...rows.map(r=>r.v));
  return rows.map(r=>{
    const p=r.v/max*100;
    return `<div style="margin-bottom:9px">
      <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
        <span style="color:var(--ink)">${r.k}</span>
        <span class="num" style="color:var(--ink-2)">${opts.fmt?opts.fmt(r.v):r.v}</span></div>
      <div style="height:8px;background:var(--line-soft);border-radius:4px;overflow:hidden">
        <div style="width:${p}%;height:100%;background:${r.color||'var(--blue)'};border-radius:4px"></div></div></div>`;
  }).join('');
}

function stackedPct(rows,opts={}){
  const w=opts.w||620,h=opts.h||280,m={t:12,r:10,b:34,l:34};
  const iw=w-m.l-m.r, ih=h-m.t-m.b, bw=iw/rows.length*.62, gap=iw/rows.length;
  let s=svgEl(w,h);
  [0,25,50,75,100].forEach(v=>{const y=m.t+ih-v/100*ih;
    s+=`<line x1="${m.l}" y1="${y}" x2="${w-m.r}" y2="${y}" stroke="var(--line-soft)"/>
        <text x="${m.l-7}" y="${y+3.5}" text-anchor="end" font-size="9.5" fill="var(--muted)">${v}%</text>`});
  rows.forEach((r,i)=>{
    const x=m.l+i*gap+(gap-bw)/2; let acc=0;
    r.parts.forEach(p=>{
      const hh=p.v*ih; const y=m.t+ih-acc-hh; acc+=hh;
      s+=`<rect x="${x}" y="${y}" width="${bw}" height="${Math.max(hh,0)}" fill="${p.color}" rx="1.5"
           class="pt" data-t="${r.k} · ${p.name}\n${pct(p.v)}"/>`;
      if(hh>19)s+=`<text x="${x+bw/2}" y="${y+hh/2+3.5}" text-anchor="middle" font-size="10.5"
           fill="${p.dark?'var(--navy)':'#fff'}" font-weight="600">${Math.round(p.v*100)}%</text>`});
    s+=`<text x="${x+bw/2}" y="${h-12}" text-anchor="middle" font-size="10.5" fill="var(--ink-2)">${r.k}</text>`});
  s+='</svg>';
  const leg=rows[0].parts.map(p=>`<span style="display:inline-flex;align-items:center;gap:6px;margin-right:16px;font-size:11.5px;color:var(--ink-2)">
    <i style="width:11px;height:11px;background:${p.color};border-radius:3px;display:inline-block"></i>${p.name}</span>`).join('');
  return s+`<div style="margin-top:10px">${leg}</div>`;
}

function scatter(pts,opts={}){
  const w=opts.w||620,h=opts.h||330,m={t:16,r:20,b:40,l:52};
  const iw=w-m.l-m.r, ih=h-m.t-m.b;
  const xs=pts.map(p=>p.x), ys=pts.map(p=>p.y);
  const xm=Math.max(...xs)*1.06, ym=Math.max(...ys)*1.12;
  const X=v=>m.l+v/xm*iw, Y=v=>m.t+ih-v/ym*ih;
  const rmax=Math.max(...pts.map(p=>Math.abs(p.r||1)));
  let s=svgEl(w,h);
  for(let i=0;i<=4;i++){const v=ym*i/4,y=Y(v);
    s+=`<line x1="${m.l}" y1="${y}" x2="${w-m.r}" y2="${y}" stroke="var(--line-soft)"/>
        <text x="${m.l-8}" y="${y+3.5}" text-anchor="end" font-size="10" fill="var(--muted)">${pct(v,0)}</text>`}
  for(let i=0;i<=4;i++){const v=xm*i/4;
    s+=`<text x="${X(v)}" y="${h-14}" text-anchor="middle" font-size="10" fill="var(--muted)">${moneyK(v)}</text>`}
  if(opts.ref!=null){const y=Y(opts.ref);
    s+=`<line x1="${m.l}" y1="${y}" x2="${w-m.r}" y2="${y}" stroke="var(--navy)" stroke-width="1.4" stroke-dasharray="5 4"/>
        <text x="${w-m.r}" y="${y-7}" text-anchor="end" font-size="10" fill="var(--navy)">média ${pct(opts.ref)}</text>`}
  pts.forEach(p=>{
    const rr=6+Math.sqrt(Math.abs(p.r||1)/rmax)*15;
    s+=`<circle cx="${X(p.x)}" cy="${Y(p.y)}" r="${rr}" fill="${p.color}" opacity=".6" stroke="${p.color}" stroke-width="1.4"
         class="pt" data-t="${p.k}\ngross ${moneyK(p.x)} · saída ${pct(p.y)}${p.r!=null?'\nnet '+moneyK(p.r):''}"/>`;
    if(p.label)s+=`<text x="${X(p.x)}" y="${Y(p.y)-rr-5}" text-anchor="middle" font-size="10" fill="var(--ink-2)">${p.k}</text>`});
  s+=`<text x="${m.l+iw/2}" y="${h-1}" text-anchor="middle" font-size="10" fill="var(--muted)">gross do ano</text>`;
  return s+'</svg>';
}

function spark(vals,color){
  const w=150,h=30,lo=Math.min(...vals),hi=Math.max(...vals);
  const X=i=>i*w/(vals.length-1), Y=v=>h-2-(v-lo)/((hi-lo)||1)*(h-6);
  const d=vals.map((v,i)=>(i?'L':'M')+X(i).toFixed(1)+' '+Y(v).toFixed(1)).join(' ');
  return `<svg viewBox="0 0 ${w} ${h}" width="${w}" height="${h}" style="display:block">
    <path d="${d} L${w} ${h} L0 ${h} Z" fill="${color}" opacity=".08"/>
    <path d="${d}" fill="none" stroke="${color}" stroke-width="1.9" stroke-linejoin="round"/>
    <circle cx="${X(vals.length-1)}" cy="${Y(vals.at(-1))}" r="2.6" fill="${color}"/></svg>`;
}

/* ---------------- sortable table ---------------- */
function table(cols,rows,opts={}){
  const id='t'+Math.random().toString(36).slice(2,7);
  const head=cols.map((c,i)=>`<th class="${c.r?'r':''}" data-i="${i}">${c.h}<span class="ar">↕</span></th>`).join('');
  const body=rows.map(r=>'<tr>'+cols.map(c=>{
    const v=c.get(r);
    const cls=(c.r?'r ':'')+(c.num?'num ':'');
    if(c.bar!=null){const p=Math.max(0,Math.min(1,c.bar(r)))*100;
      return `<td class="${cls}bar-cell"><i style="width:${p}%"></i><span>${v}</span></td>`}
    return `<td class="${cls}">${v}</td>`}).join('')+'</tr>').join('');
  setTimeout(()=>{
    const t=$('#'+id); if(!t)return;
    $$('th',t).forEach(th=>th.onclick=()=>{
      const i=+th.dataset.i, c=cols[i], tb=$('tbody',t);
      const dir=th.dataset.d==='a'?-1:1; $$('th',t).forEach(x=>delete x.dataset.d); th.dataset.d=dir>0?'a':'d';
      const sorted=[...rows].sort((x,y)=>{
        const a=c.sort?c.sort(x):c.get(x), b=c.sort?c.sort(y):c.get(y);
        if(typeof a==='number'&&typeof b==='number')return (a-b)*dir;
        return String(a).localeCompare(String(b),'pt-BR')*dir});
      tb.innerHTML=sorted.map(r=>'<tr>'+cols.map(c=>{
        const v=c.get(r), cls=(c.r?'r ':'')+(c.num?'num ':'');
        if(c.bar!=null){const p=Math.max(0,Math.min(1,c.bar(r)))*100;
          return `<td class="${cls}bar-cell"><i style="width:${p}%"></i><span>${v}</span></td>`}
        return `<td class="${cls}">${v}</td>`}).join('')+'</tr>').join('');
    });
  },0);
  return `<div class="tw"><table id="${id}"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;
}

