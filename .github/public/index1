    {h:'Margem',r:1,num:1,get:r=>pct(N(r['Margem liquida oficial'])),sort:r=>N(r['Margem liquida oficial'])??-1},
    {h:'Situação',get:r=>{const c=String(r.Classificacao||'');
      const cls=/NEGATIVO/.test(c)?'t-red':/ATENCAO/.test(c)?'t-amber':/POSITIVO/.test(c)?'t-green':'t-grey';
