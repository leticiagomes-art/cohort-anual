      return v==null?'—':`<b style="color:${v<0?'var(--green)':'var(--red)'}">${(v*100).toFixed(1).replace('.',',')} pp</b>`},
      sort:r=>N(r['Delta da taxa (WHITE - BLACK)'])??0},
    {h:'Dias de White',r:1,num:1,get:r=>N(r['Dias de White ate hoje'])??'—',sort:r=>N(r['Dias de White ate hoje'])||0},
    {h:'Veredito',get:r=>{const v=String(r.Veredito||'');const cls=/PIOROU/.test(v)?'t-red':/MELHOROU\?/.test(v)?'t-amber':/MELHOROU/.test(v)?'t-green':'t-grey';
      return `<span class="tag ${cls}">${/PIOROU/.test(v)?'piorou':/MELHOROU/.test(v)?'melhorou?':'—'}</span>`},sort:r=>String(r.Veredito)}
