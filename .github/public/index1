    {h:'% saída',r:1,num:1,get:r=>{const v=N(r['% Saida total ($)']);
      return v==null?'<span style="color:var(--muted)">n/d</span>':`<b style="color:${v>=.28?'var(--red)':v>=.2?'var(--amber)':'var(--ink)'}">${pct(v)}</b>`},
      sort:r=>N(r['% Saida total ($)'])??-1},
