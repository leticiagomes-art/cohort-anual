          <span class="num" style="font-size:12px;color:var(--muted);margin-left:8px">${q.length} produtos · ${moneyK(q.reduce((a,r)=>a+N(r.Gross),0))}</span>
          <div style="font-size:12px;color:var(--ink-2);margin-top:5px">${q.slice(0,6).map(r=>r.produto).join(', ')}${q.length>6?'…':''}</div></div>`}).join('')}
