  const so=rc.reduce((a,r)=>a+(N(r['Reembolso oficial'])||0),0), sc=rc.reduce((a,r)=>a+(N(r['Reembolso calculado'])||0),0);
  return `<div class="grid g4">
    <div class="card kpi is-green"><div class="lab">Gap no reembolso</div><div class="val">${pct(Math.abs(so-sc)/so,1)}</div>
      <div class="note">calculado vs Master Accounts oficial</div></div>
    <div class="card kpi is-green"><div class="lab">Casamento por Order ID</div><div class="val">88,2%</div>
      <div class="note">reembolsos ligados à base de pedidos</div></div>
    <div class="card kpi is-amber"><div class="lab">Duplicidade removida</div><div class="val">$26.375</div>
      <div class="note">82 chargebacks dentro do arquivo de reembolso</div></div>
    <div class="card kpi is-navy"><div class="lab">Contas conferidas</div><div class="val">${rc.length}</div>
      <div class="note">uma a uma contra o oficial</div></div>
  </div>
  <div class="sec">Reconciliação conta a conta</div>
  ${table([
    {h:'Conta',get:r=>r['Conta (oficial)']},
    {h:'Gross oficial',r:1,num:1,get:r=>money(N(r['Gross oficial'])),sort:r=>N(r['Gross oficial'])||0},
    {h:'Gross calculado',r:1,num:1,get:r=>money(N(r['Gross calculado'])),sort:r=>N(r['Gross calculado'])||0},
    {h:'Reembolso oficial',r:1,num:1,get:r=>money(N(r['Reembolso oficial'])),sort:r=>N(r['Reembolso oficial'])||0},
    {h:'Reembolso calculado',r:1,num:1,get:r=>money(N(r['Reembolso calculado'])),sort:r=>N(r['Reembolso calculado'])||0},
    {h:'Gap',r:1,num:1,get:r=>{const v=N(r['% do gap de reembolso']);
